# =============================================================================
# VoCall - Environment Variable Configuration
# =============================================================================

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# LLM Providers
GROQ_API_KEY=gsk_your_groq_api_key
CEREBRAS_API_KEY=csk_your_cerebras_api_key

# Redis / Caching (Upstash)
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# Graph Database (FalkorDB)
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379

# Real-Time Voice & Video (LiveKit)
LIVEKIT_URL=wss://your-livekit-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Telephony Integration (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Backend public URL (used for Twilio webhook callbacks and WebSocket bridge)
# In production: your Railway/Render URL e.g. https://vocall-api.railway.app
# In dev: use ngrok — ngrok http 8000 -> set this to your ngrok HTTPS URL
BACKEND_PUBLIC_URL=https://your-backend.railway.app

# Speech & Voice AI (STT/TTS/Audio)
SARVAM_API_KEY=sk_your_sarvam_api_key
CARTESIA_API_KEY=your_cartesia_api_key
HUME_API_KEY=your_hume_api_key

# Email & Workflows
RESEND_API_KEY=re_your_resend_api_key
TRIGGER_SECRET_KEY=tr_your_trigger_secret_key

# Configurable Hyperparameters & Model Overrides
RETRIEVAL_TOP_K=5
RETRIEVAL_TAU=0.75
EPISODIC_LIMIT=3
FUSION_AUDIO_WEIGHT=0.6
TONE_THRESHOLD_MILD=0.4
TONE_THRESHOLD_STRONG=0.6
TONE_THRESHOLD_POSITIVE=0.6
ALERT_THRESHOLD=0.7
LLM_MODEL=llama-3.3-70b-versatile
LLM_FALLBACK_MODEL=llama3-70b-8192
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
INTENT_CONFIDENCE_MIN=0.70
SLOT_TTL_SECONDS=3600
PIPELINE_MODE=custom

# Voice Activity Detection (VAD) / Telephony Audio Framing
VAD_ENERGY_THRESHOLD=400.0
VAD_FRAME_MS=20
VAD_SILENCE_MS=700
VAD_MIN_MS=120
VAD_MAX_MS=15000
